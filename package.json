{
  "name": "simulator-ball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts --dev",
    "build": "tsc --noEmit && vite build && vite build --ssr src/server/index.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node tools/scripts/fetch-mediamtx.mjs",
    "fetch:mediamtx": "node tools/scripts/fetch-mediamtx.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "ffmpeg-static": "^5.3.0",
    "puppeteer": "^25.17.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  }
}
